# Copia este archivo a .env y cambia los valores antes de iniciar el servicio.
STATION_USERNAME=operator
STATION_PASSWORD=replace-with-a-long-unique-password
STATION_SESSION_SECRET=replace-with-at-least-64-random-hex-characters

# false solo para acceso HTTP en una red local/VPN confiable.
# Usa true cuando el navegador acceda mediante HTTPS/WSS.
COOKIE_SECURE=false
